<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:CompressionLab.ViewModels" mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="700" x:Class="CompressionLab.Views.MainView" x:DataType="vm:MainViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Auto"><StackPanel Margin="28" Spacing="18" MinWidth="760" HorizontalAlignment="Center">
    <TextBlock Text="Compression Lab" FontSize="30" FontWeight="Bold"/><TextBlock Text="Quantização RGB332 e RLE em uma imagem de teste gerada localmente." Opacity="0.75"/><Button Content="Calcular compressão" Command="{Binding CompressCommand}" HorizontalAlignment="Left"/>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="18"><StackPanel Grid.Column="0" Spacing="8"><TextBlock Text="Imagem original (RGB)" FontWeight="SemiBold"/><Border Padding="5" Background="#E2E8F0" CornerRadius="6"><ItemsControl ItemsSource="{Binding Original}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="24"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="18" Height="18" Margin="1" Background="{Binding Fill}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Após quantização RGB332" FontWeight="SemiBold"/><Border Padding="5" Background="#E2E8F0" CornerRadius="6"><ItemsControl ItemsSource="{Binding Quantized}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="24"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="18" Height="18" Margin="1" Background="{Binding Fill}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border></StackPanel></Grid>
    <Border Padding="14" Background="#F1F5F9" CornerRadius="8"><TextBlock Text="{Binding Report}" TextWrapping="Wrap"/></Border>
  </StackPanel></ScrollViewer>
</UserControl>
